          "expr": "sum by (tool) (rate(agent_tool_calls_total{error_type!~\"none|denied\"}[10m])) / sum by (tool) (rate(agent_tool_calls_total[10m]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
