        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status, reason) (rate(agent_runs_total[5m]))",
          "legendFormat": "{{status}} / {{reason}}",
          "refId": "A",
          "range": true,
          "instant": false
