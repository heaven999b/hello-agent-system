# 参考服务的全部配置项（12-factor：代码里没有任何地址、密钥、配额）。只有占位符，复制为 production/.env 后填写，**不要提交**。
# 本机 run_local.py 会自动生成数据库、Redis 地址和 API key，不需要这个文件；docker compose / K8s 才需要。

# ---------------- 必填 ----------------
DATABASE_URL=postgresql://itdesk:${POSTGRES_PASSWORD}@localhost:5432/itdesk
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ---------------- 身份 ----------------
# 生产：网关验证 JWT 后注入身份，这一项留空。本地：{sha256(key): {"tenant","user","roles","plan","department"}}
API_KEYS_JSON={}
POD_NAME=                         # K8s 用 Downward API 注入 Pod 名；留空则用 主机名-进程号
SERVICE_NAME=                     # 默认 itdesk-api / itdesk-worker
DEPLOYMENT_ENV=dev

# ---------------- 模型 ----------------
LLM_BACKEND=litellm               # litellm（进程内 Router，第 29 课）| openai（直连 OpenAI 兼容网关）| scripted（离线剧本，压测用）
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=REPLACE_ME            # 网关发的虚拟 key；不要放厂商的真实 key
LLM_MODEL=gpt-5.5
LLM_FALLBACK_MODEL=
LLM_MAX_CONCURRENCY=32            # 本进程对模型的在途上限（舱壁）
SCRIPTED_LLM_LATENCY_MS=300       # 仅 scripted：每次调用的模拟延迟
SCRIPTED_LLM_JITTER=0.3
RUN_TIMEOUT_SECONDS=120
MAX_STEPS=8
TOOL_LATENCY_MS=50                # 模拟的下游（工单系统）响应时间
DIAGNOSTICS_LATENCY_MS=1500

# ---------------- worker ----------------
WORKER_CONCURRENCY=16
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10       # 必须 ≤ 租约的一半，建议 1/3
WORKER_GRACE_SECONDS=20           # 要小于 terminationGracePeriodSeconds - preStop - 收尾时间
WORKER_POLL_SECONDS=0.5
WORKER_RELEASE_ON_CANCEL=true
WORKER_HEALTH_PORT=8081
WORKER_HEALTH_ADDR=0.0.0.0
METRICS_PORT=9100
METRICS_ADDR=127.0.0.1

# ---------------- 限流与舱壁 ----------------
API_RATE_PER_SEC=10
API_BURST=20
API_RATE_OVERRIDES_JSON={}        # 例：{"big-customer": [50, 100]}
LLM_RATE_PER_SEC=20
LLM_BURST=40
LLM_RATE_WAIT_SECONDS=2
STREAMS_PER_TENANT=20
STREAMS_GLOBAL=200
STREAM_ADMISSION_TIMEOUT_MS=50
PG_POOL_MIN=2
PG_POOL_MAX=10

# ---------------- 事件与 SSE ----------------
EVENTS_MAXLEN=500
EVENTS_TTL_SECONDS=86400
SSE_MAX_SECONDS=600

# ---------------- 可观测性 ----------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=1.0
SPANS_JSONL_DIR=                  # 测试 / 本机排查：把 span 写成 JSONL
PROMETHEUS_MULTIPROC_DIR=         # 一个容器里跑多个进程时才设置（每次启动前清空）

# ---------------- 策略 ----------------
CEDAR_POLICIES=lessons/29_gateway_and_guardrails/configs/policies.cedar
CEDAR_SCHEMA=lessons/29_gateway_and_guardrails/configs/schema.cedarschema
SEED_DEMO_DATA=true

# ---------------- 只给 docker compose 用 ----------------
POSTGRES_PASSWORD=REPLACE_ME
REDIS_PASSWORD=REPLACE_ME
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
REDACTION_HMAC_KEY=REPLACE_ME
LANGFUSE_AUTH=
LITELLM_MASTER_KEY=REPLACE_ME
LITELLM_VIRTUAL_KEY=REPLACE_ME
CLIPROXY_API_BASE=http://host.docker.internal:8317/v1
CLIPROXY_API_KEY=REPLACE_ME
OPENAI_API_KEY=
